<template>
  <main class="app">
    <header class="topbar">
      <div class="identity"><strong class="brand">LIGHTCEPT</strong><span class="photo-name" #if="photoName !== ''" :title="photoName">{{ photoName }}</span></div>
      <div class="header-actions"><span class="header-status" #if="status !== '' || rendering" role="status" aria-live="polite" :title="rendering ? 'Updating preview…' : status">{{ rendering ? 'Updating preview…' : status }}</span><button class="quiet-button" #if="!opening && !saving && !exporting" :disabled="rendering" @click="openProject">Open Project</button><button class="quiet-button" #if="hasPhoto && !opening && !saving && !exporting" :disabled="rendering || !developAvailable" @click="saveProject">Save Project</button><button class="quiet-button" #if="developAvailable && !opening && !saving && !exporting" :disabled="rendering" @click="exportTiff">Export TIFF</button><button class="quiet-button" #if="hasPhoto && !opening && !saving && !exporting" :disabled="rendering" @click="open">Open Photo</button><button class="quiet-button" #if="cancellableOpening" @click="cancel">Cancel</button><button class="quiet-button" #if="exporting" @click="cancelTiffExport">Cancel export</button></div>
    </header>
    <section class="workspace">
      <aside class="navigator">
        <h2 class="section-heading">Navigator</h2>
        <div class="navigator-frame"><div id="navigator-preview" class="navigator-preview"></div></div>
        <p class="source-note" #if="hasPhoto">FITTED VIEW</p>
        <div class="navigator-group edits-group" #if="hasPhoto && developAvailable"><h3>Edits</h3><p class="edit-position">{{ historyPosition() }}</p><div class="edit-actions"><button class="quiet-button" :disabled="opening || rendering || !canUndo" @click="undo">Earlier</button><button class="quiet-button" :disabled="opening || rendering || !canRedo" @click="redo">Later</button></div></div>
      </aside>
      <section class="editor">
        <div class="editor-toolbar"><div class="comparison-actions" #if="developAvailable && previewFailure === ''" role="group" aria-label="Comparison view"><button :aria-pressed="comparisonMode === 1 ? 'true' : 'false'" :disabled="opening || rendering" title="Show the original photograph" @click="setComparison(1)">Original</button><button :aria-pressed="comparisonMode === 0 ? 'true' : 'false'" :disabled="opening || rendering" title="Show the current edited result" @click="setComparison(0)">Edited</button><button :aria-pressed="comparisonMode === 2 ? 'true' : 'false'" :disabled="opening || rendering" title="Drag the divider to compare" @click="setComparison(2)">Split</button></div><button class="icon-button" #if="developAvailable && previewFailure === ''" :aria-pressed="cropMode ? 'true' : 'false'" aria-label="Crop photograph" title="Crop photograph" :disabled="opening || rendering" @click="toggleCrop"><span class="crop-icon" aria-hidden="true"></span><span>Crop</span></button><div class="preview-error" #if="previewFailure !== '' && hasPhoto" role="alert"><span>{{ previewFailure }}</span><div #if="failedBatch.length > 0" class="preview-recovery"><button @click="retryPreview">Retry preview</button><button @click="discardFailedPreview">Use completed result</button></div></div><label class="proof-choice" #if="developAvailable && previewFailure === ''">Soft Proof <select aria-label="Soft Proof profile" :disabled="opening || rendering" @change="changeProof"><option value="0">Off</option><option value="1">sRGB</option><option value="2">Adobe RGB</option><option value="3">Monitor ICC</option></select></label></div>
        <div class="crop-panel" #if="cropMode && hasPhoto"><span>Drag to crop; drag inside to move or a corner to resize</span><label>Ratio <select aria-label="Crop ratio" :value="cropRatio" @change="changeCropRatio"><option value="0">Free</option><option value="1">1:1</option><option value="2">4:3</option><option value="3">3:2</option><option value="4">16:9</option></select></label><label>Straighten <input aria-label="Straighten angle" type="range" min="-17" max="17" step="0.1" :value="cropAngle / 1000" @input="changeCropAngle" /></label><span>{{ (cropAngle / 1000).toFixed(1) }}°</span><label>Orientation <select aria-label="Photo orientation" :disabled="!cropDraft || opening || rendering" @change="changeOrientation"><option value="0">Choose…</option><option value="1">Original</option><option value="2">Flip horizontal</option><option value="3">Rotate 180°</option><option value="4">Flip vertical</option><option value="5">Transpose</option><option value="6">Rotate right 90°</option><option value="7">Transverse</option><option value="8">Rotate left 90°</option></select></label><button :disabled="!cropDraft || opening || rendering" @click="applyCrop">Apply</button><button @click="closeCrop">Cancel</button></div>
        <div class="stage"><div id="photo-preview" class="preview"></div><div class="empty" #if="!hasPhoto"><div class="empty-mark">✳</div><h1 class="empty-title">Your photograph starts here</h1><p>Open a supported RAW photo to view and develop it.</p><button class="open-button" :disabled="opening || rendering" @click="open">Open Photo</button></div></div>
        <div class="canvas-footer" #if="hasPhoto"><span #if="comparisonMode === 2">Drag divider to compare original and edited</span><div><PhotoZoomControls :percent="zoomPercent" :sourceDetailReady="sourceDetailReady" @preview="previewZoom" @select="setZoom" /></div></div>
      </section>
      <aside class="develop-rail" :inert="failedBatch.length > 0 ? '' : null">
        <div class="develop-header"><h2>Develop</h2></div>
        <div class="histogram"><div class="histogram-heading"><span>HISTOGRAM</span><span class="histogram-mode" #if="hasPhoto">RGB · LUMA</span></div><div class="histogram-grid"><div id="histogram-preview" class="histogram-preview"></div><span #if="!hasPhoto">Open a photograph</span></div><div class="histogram-scale"><span>SHADOWS</span><span>MIDTONES</span><span>HIGHLIGHTS</span></div></div>
        <div class="develop-tabs" role="tablist" aria-label="Develop controls" @keydown="onTabKeydown"><button id="develop-tab-light" role="tab" aria-controls="develop-panel-light" :aria-selected="activeTab === 'light' ? 'true' : 'false'" :tabindex="activeTab === 'light' ? 0 : -1" :class="activeTab === 'light' ? 'selected' : ''" @click="selectTab('light')">Light</button><button id="develop-tab-color" role="tab" aria-controls="develop-panel-color" :aria-selected="activeTab === 'color' ? 'true' : 'false'" :tabindex="activeTab === 'color' ? 0 : -1" :class="activeTab === 'color' ? 'selected' : ''" @click="selectTab('color')">Color</button><button id="develop-tab-detail" role="tab" aria-controls="develop-panel-detail" :aria-selected="activeTab === 'detail' ? 'true' : 'false'" :tabindex="activeTab === 'detail' ? 0 : -1" :class="activeTab === 'detail' ? 'selected' : ''" @click="selectTab('detail')">Detail</button></div>
        <div class="help-card" role="status" #if="helpText !== ''">{{ helpText }}</div>
        <div id="develop-panel-light" role="tabpanel" aria-labelledby="develop-tab-light" :class="activeTab === 'light' ? 'develop-content' : 'develop-content inactive'"><div class="group-title-row"><h3 class="group-heading">Light</h3><button #if="developAvailable" class="reset-button" :disabled="opening || rendering || !lightChanged()" @click="resetLight">Reset Light</button></div><p class="group-description">Shape brightness, tonal detail, and the darkest and brightest points.</p>
          <section class="adjustment-section" #if="developAvailable" aria-label="Overall brightness">
          <h4 class="control-section">Overall brightness</h4>
          <p #if="developAvailable" class="control-cue">Make the whole photograph lighter or darker.</p>
          <div :class="developAvailable ? '' : 'hidden-control'"><DevelopSlider :id="'exposure'" :name="'Exposure'" :help="'Brightens or darkens the whole photo. One EV doubles or halves the light.'" :value="exposureTenths" :displayValue="exposureLabel()" :min="-40" :max="40" :stepAmount="5" :lowLabel="'−4 EV'" :highLabel="'+4 EV'" :disabled="!developAvailable" @preview="previewControl" @commit="commitControlChange" @step="stepControl" @reset="resetControl" @help="showHelp" @hide-help="closeHelp" /></div>
          </section>
          <section class="adjustment-section" #if="developAvailable" aria-label="Bright and dark detail">
          <h4 class="control-section">Bright and dark detail</h4>
          <p #if="developAvailable" class="control-cue">Adjust the brighter and darker areas separately.</p>
          <div :class="developAvailable ? '' : 'hidden-control'"><DevelopSlider :id="'shadows'" :name="'Shadows'" :help="'Changes darker tones while leaving brighter areas less affected.'" :value="shadowsPercent" :displayValue="toneLabel(shadowsPercent)" :min="-100" :max="100" :stepAmount="10" :lowLabel="'−100'" :highLabel="'+100'" :disabled="!developAvailable" @preview="previewControl" @commit="commitControlChange" @step="stepControl" @reset="resetControl" @help="showHelp" @hide-help="closeHelp" /></div>
          <div :class="developAvailable ? '' : 'hidden-control'"><DevelopSlider :id="'highlights'" :name="'Highlights'" :help="'Changes brighter tones while leaving darker areas less affected.'" :value="highlightsPercent" :displayValue="toneLabel(highlightsPercent)" :min="-100" :max="100" :stepAmount="10" :lowLabel="'−100'" :highLabel="'+100'" :disabled="!developAvailable" @preview="previewControl" @commit="commitControlChange" @step="stepControl" @reset="resetControl" @help="showHelp" @hide-help="closeHelp" /></div>
          </section>
          <section class="adjustment-section" #if="developAvailable" aria-label="Depth">
          <h4 class="control-section">Depth</h4>
          <p #if="developAvailable" class="control-cue">Set the separation between light and dark, then refine the endpoints.</p>
          <div :class="developAvailable ? '' : 'hidden-control'"><DevelopSlider :id="'contrast'" :name="'Contrast'" :help="'Increases or reduces the separation between dark and bright tones.'" :value="contrastPercent" :displayValue="contrastLabel()" :min="-100" :max="100" :stepAmount="10" :lowLabel="'−100'" :highLabel="'+100'" :disabled="!developAvailable" @preview="previewControl" @commit="commitControlChange" @step="stepControl" @reset="resetControl" @help="showHelp" @hide-help="closeHelp" /></div>
          <div :class="developAvailable ? '' : 'hidden-control'"><DevelopSlider :id="'blacks'" :name="'Blacks'" :help="'Sets the depth of the darkest tones.'" :value="blacksPercent" :displayValue="toneLabel(blacksPercent)" :min="-100" :max="100" :stepAmount="10" :lowLabel="'−100'" :highLabel="'+100'" :disabled="!developAvailable" @preview="previewControl" @commit="commitControlChange" @step="stepControl" @reset="resetControl" @help="showHelp" @hide-help="closeHelp" /></div>
          <div :class="developAvailable ? '' : 'hidden-control'"><DevelopSlider :id="'whites'" :name="'Whites'" :help="'Sets the brightest tones and highlight brightness.'" :value="whitesPercent" :displayValue="toneLabel(whitesPercent)" :min="-100" :max="100" :stepAmount="10" :lowLabel="'−100'" :highLabel="'+100'" :disabled="!developAvailable" @preview="previewControl" @commit="commitControlChange" @step="stepControl" @reset="resetControl" @help="showHelp" @hide-help="closeHelp" /></div>
          </section>
          <section class="curve-editor" #if="developAvailable" aria-label="Precise tone">
            <button type="button" class="disclosure-button" :aria-expanded="curvesOpen ? 'true' : 'false'" aria-controls="curve-controls" @click="toggleCurves">{{ curvesChanged() ? 'Precise tone · adjusted' : 'Precise tone' }} <span aria-hidden="true">{{ curvesOpen ? '▾' : '▸' }}</span></button>
            <div id="curve-controls" :class="curvesOpen ? '' : 'disclosure-closed'">
            <p class="curve-description">Shape overall brightness or individual color channels across shadows, midtones, and highlights.</p>
            <div class="curve-channels" role="tablist" aria-label="Curve channel"><button type="button" #for="channel in curveChannels" role="tab" :aria-selected="curveChannel === channel.index ? 'true' : 'false'" :class="curveChannel === channel.index ? 'selected' : ''" :data-channel="channel.index" @click="selectCurveChannel">{{ channel.name }}</button></div>
            <canvas id="curve-graph" class="curve-graph" width="200" height="200" role="group" :aria-label="curveGraphLabel()" @pointerdown="startCurveDrag" @pointermove="moveCurveDrag" @pointerup="finishCurveDrag" @pointercancel="cancelCurveDrag"></canvas>
            <div class="curve-sliders"><DevelopSlider #for="row in curveRows" :id="row.id" :name="row.name" :help="row.help" :value="row.value" :resetValue="row.neutral" :displayValue="row.display" :min="row.min" :max="row.max" :stepAmount="10" :lowLabel="'Darker'" :highLabel="'Brighter'" :disabled="!developAvailable" @preview="previewCurve" @commit="commitCurve" @step="stepCurve" @reset="resetCurvePoint" @help="showHelp" @hide-help="closeHelp" /></div>
            </div>
          </section>
          <p #if="hasPhoto && !developAvailable" class="availability">This photograph can be viewed. Develop controls require a qualified RAW variant.</p>
          <p #if="!hasPhoto" class="availability">Develop controls appear when a qualified photograph is open.</p>
          <div class="develop-divider" #if="hasPhoto"></div><p class="source-safety" #if="hasPhoto">Original photograph preserved</p>
        </div>
        <div id="develop-panel-color" role="tabpanel" aria-labelledby="develop-tab-color" :class="activeTab === 'color' ? 'develop-content' : 'develop-content inactive'">
          <div class="group-title-row"><h3 class="group-heading">Color</h3><button #if="developAvailable" class="reset-button" :disabled="opening || rendering || !colorChanged()" @click="resetColor">Reset basic color</button></div>
          <p #if="developAvailable" class="group-description">Start with the whole photograph, then choose a specific color if needed. Warmth and tint are relative to the camera’s as shot color.</p>
          <section class="adjustment-section" #if="developAvailable" aria-label="Overall color">
          <h4 class="control-section">Overall color</h4>
          <div :class="developAvailable ? '' : 'hidden-control'"><DevelopSlider :id="'warmth'" :name="'Warmth'" :help="'Moves colors warmer or cooler relative to the camera color.'" :value="warmthPercent" :displayValue="toneLabel(warmthPercent)" :min="-100" :max="100" :stepAmount="10" :lowLabel="'Cooler'" :highLabel="'Warmer'" :disabled="!developAvailable" @preview="previewControl" @commit="commitControlChange" @step="stepControl" @reset="resetControl" @help="showHelp" @hide-help="closeHelp" /></div>
          <div :class="developAvailable ? '' : 'hidden-control'"><DevelopSlider :id="'tint'" :name="'Tint'" :help="'Moves colors toward magenta or green relative to the camera color.'" :value="tintPercent" :displayValue="toneLabel(tintPercent)" :min="-100" :max="100" :stepAmount="10" :lowLabel="'Greener'" :highLabel="'More magenta'" :disabled="!developAvailable" @preview="previewControl" @commit="commitControlChange" @step="stepControl" @reset="resetControl" @help="showHelp" @hide-help="closeHelp" /></div>
          <div :class="developAvailable ? '' : 'hidden-control'"><DevelopSlider :id="'vibrance'" :name="'Vibrance'" :help="'Changes muted colors more strongly than already vivid colors.'" :value="vibrancePercent" :displayValue="toneLabel(vibrancePercent)" :min="-100" :max="100" :stepAmount="10" :lowLabel="'Less'" :highLabel="'More'" :disabled="!developAvailable" @preview="previewControl" @commit="commitControlChange" @step="stepControl" @reset="resetControl" @help="showHelp" @hide-help="closeHelp" /></div>
          <button #if="developAvailable" type="button" class="disclosure-button" :aria-expanded="moreColorOpen ? 'true' : 'false'" aria-controls="more-color" @click="toggleMoreColor">{{ saturationPercent !== 0 ? 'More color control · adjusted' : 'More color control' }} <span aria-hidden="true">{{ moreColorOpen ? '▾' : '▸' }}</span></button>
          <div id="more-color" :class="moreColorOpen ? '' : 'disclosure-closed'"><div :class="developAvailable ? '' : 'hidden-control'"><DevelopSlider :id="'saturation'" :name="'Saturation'" :help="'Changes all colors equally. Minus 100 makes the photo monochrome.'" :value="saturationPercent" :displayValue="toneLabel(saturationPercent)" :min="-100" :max="100" :stepAmount="10" :lowLabel="'Monochrome'" :highLabel="'More color'" :disabled="!developAvailable" @preview="previewControl" @commit="commitControlChange" @step="stepControl" @reset="resetControl" @help="showHelp" @hide-help="closeHelp" /></div></div>
          </section>
          <section class="adjustment-section" #if="developAvailable" aria-label="Specific colors">
          <h4 class="control-section">Specific colors</h4>
          <p #if="developAvailable" class="control-cue">Pick a color from the photograph or choose a color group.</p>
          <div class="color-methods" #if="developAvailable" role="tablist" aria-label="Choose specific colors"><button type="button" role="tab" :aria-selected="colorMode === 'picked' ? 'true' : 'false'" :class="colorMode === 'picked' ? 'selected' : ''" @click="selectColorMode('picked')">Pick from photo</button><button type="button" role="tab" :aria-selected="colorMode === 'groups' ? 'true' : 'false'" :class="colorMode === 'groups' ? 'selected' : ''" @click="selectColorMode('groups')">Color Groups</button></div>
          <section class="hsl-editor" #if="developAvailable && colorMode === 'groups'" aria-label="Color Groups">
            <div class="hsl-heading"><span class="hsl-view-label">View</span><div class="hsl-layouts" role="group" aria-label="Color Groups layout">
              <button type="button" aria-label="By adjustment" title="By adjustment" :aria-pressed="hslLayout === 'adjustment' ? 'true' : 'false'" @click="selectHslLayout('adjustment')"><span class="layout-adjustment-icon" aria-hidden="true"><i></i><i></i><i></i></span></button>
              <button type="button" aria-label="By color" title="By color" :aria-pressed="hslLayout === 'color' ? 'true' : 'false'" @click="selectHslLayout('color')"><span class="layout-color-icon" aria-hidden="true"><i></i><i></i><i></i></span></button>
            </div></div>
            <div #if="hslLayout === 'adjustment'">
              <div class="hsl-modes" role="tablist" aria-label="Color Mixer adjustment"><button type="button" role="tab" :aria-selected="hslMode === 0 ? 'true' : 'false'" :class="hslMode === 0 ? 'selected' : ''" @click="selectHslMode(0)">Hue</button><button type="button" role="tab" :aria-selected="hslMode === 1 ? 'true' : 'false'" :class="hslMode === 1 ? 'selected' : ''" @click="selectHslMode(1)">Saturation</button><button type="button" role="tab" :aria-selected="hslMode === 2 ? 'true' : 'false'" :class="hslMode === 2 ? 'selected' : ''" @click="selectHslMode(2)">Luminance</button></div>
              <div class="hsl-rows"><HslMixerRow #for="row in hslRows" :band="row.band" :kind="row.kind" :name="row.name" :ariaLabel="row.ariaLabel" :swatchClass="row.swatchClass" :value="row.value" :display="row.display" :showSwatch="true" :disabled="!developAvailable" @preview="previewHslRow" @commit="commitHslRow" @step="stepHslRow" @reset="resetHslRow" /></div>
            </div>
            <div #if="hslLayout === 'color'">
              <div class="hsl-color-choices" role="group" aria-label="Choose color range"><button type="button" #for="band in hslBands" :aria-pressed="band.index === hslSelectedBand ? 'true' : 'false'" :aria-label="hslBandChanged(band.index) ? band.name + ', adjusted' : band.name" :data-band="band.index" @click="selectHslColor"><span :class="band.swatchClass" aria-hidden="true"></span>{{ band.name }}<span #if="hslBandChanged(band.index)" class="hsl-edited" aria-hidden="true"></span></button></div>
              <div class="hsl-rows"><HslMixerRow #for="row in hslColorRows" :band="row.band" :kind="row.kind" :name="row.name" :ariaLabel="row.ariaLabel" :swatchClass="row.swatchClass" :value="row.value" :display="row.display" :showSwatch="false" :disabled="!developAvailable" @preview="previewHslRow" @commit="commitHslRow" @step="stepHslRow" @reset="resetHslRow" /></div>
            </div>
            <p class="hsl-note">Each range blends smoothly into its neighbors.</p>
          </section>
          <section class="picked-editor" #if="developAvailable && colorMode === 'picked'" aria-label="Picked Color">
            <div class="group-title-row"><h4 class="control-section">Picked Color</h4><button type="button" class="quiet-button" :aria-pressed="gradeValues[19] === 1 ? 'true' : 'false'" :disabled="opening" @click="togglePickedColor">{{ gradeValues[19] === 1 ? 'Selection on' : 'Selection off' }}</button></div>
            <p class="grading-description">Choose a color, then adjust only similar colors in the photo.</p>
            <button type="button" class="quiet-button pick-color-button" :aria-pressed="pickingColor ? 'true' : 'false'" :disabled="opening" @click="startColorPick">{{ pickingColor ? 'Click a color in the photo' : 'Pick from photo' }}</button>
            <button #if="gradeValues[19] === 1" type="button" class="quiet-button pick-color-button" :aria-pressed="showAffected ? 'true' : 'false'" @click="toggleAffected">{{ showAffected ? 'Hide affected area' : 'Show affected area' }}</button>
            <div #if="gradeValues[19] === 1">
            <DevelopSlider :id="'grade-13'" :name="'Selected color'" :help="'Chooses the center hue of the selected color range.'" :value="gradeValues[13]" :displayValue="gradeValues[13] + '°'" :min="0" :max="359" :stepAmount="5" :lowLabel="'Red'" :highLabel="'Red'" :disabled="!developAvailable" @preview="previewGrade" @commit="commitGrade" @step="stepGrade" @reset="resetGrade" @help="showHelp" @hide-help="closeHelp" />
            <DevelopSlider :id="'grade-14'" :name="'Range'" :help="'Sets how far from the selected color the adjustment reaches.'" :value="gradeValues[14] || 20" :displayValue="(gradeValues[14] || 20) + '°'" :min="2" :max="90" :stepAmount="2" :lowLabel="'Narrow'" :highLabel="'Wide'" :disabled="!developAvailable" @preview="previewGrade" @commit="commitGrade" @step="stepGrade" @reset="resetGrade" @help="showHelp" @hide-help="closeHelp" />
            <DevelopSlider :id="'grade-15'" :name="'Softness'" :help="'Blends the edge of the selected color range into neighboring colors.'" :value="gradeValues[15] || 50" :displayValue="(gradeValues[15] || 50) + '%'" :min="1" :max="100" :stepAmount="5" :lowLabel="'Firm'" :highLabel="'Soft'" :disabled="!developAvailable" @preview="previewGrade" @commit="commitGrade" @step="stepGrade" @reset="resetGrade" @help="showHelp" @hide-help="closeHelp" />
            <DevelopSlider :id="'grade-16'" :name="'Hue'" :help="'Shifts the color of the selected pixels.'" :value="gradeValues[16]" :displayValue="toneLabel(gradeValues[16])" :min="-100" :max="100" :stepAmount="5" :lowLabel="'Left'" :highLabel="'Right'" :disabled="!developAvailable" @preview="previewGrade" @commit="commitGrade" @step="stepGrade" @reset="resetGrade" @help="showHelp" @hide-help="closeHelp" />
            <DevelopSlider :id="'grade-17'" :name="'Saturation'" :help="'Changes the vividness of the selected pixels.'" :value="gradeValues[17]" :displayValue="toneLabel(gradeValues[17])" :min="-100" :max="100" :stepAmount="5" :lowLabel="'Less'" :highLabel="'More'" :disabled="!developAvailable" @preview="previewGrade" @commit="commitGrade" @step="stepGrade" @reset="resetGrade" @help="showHelp" @hide-help="closeHelp" />
            <DevelopSlider :id="'grade-18'" :name="'Brightness'" :help="'Brightens or darkens the selected pixels.'" :value="gradeValues[18]" :displayValue="toneLabel(gradeValues[18])" :min="-100" :max="100" :stepAmount="5" :lowLabel="'Darker'" :highLabel="'Brighter'" :disabled="!developAvailable" @preview="previewGrade" @commit="commitGrade" @step="stepGrade" @reset="resetGrade" @help="showHelp" @hide-help="closeHelp" />
            </div>
          </section>
          </section>
          <section class="adjustment-section creative-color" #if="developAvailable" aria-label="Creative color">
            <button type="button" class="disclosure-button" :aria-expanded="gradeOpen ? 'true' : 'false'" aria-controls="color-grade-controls" @click="toggleGrade">{{ gradingChanged() ? 'Creative color · adjusted' : 'Creative color' }} <span aria-hidden="true">{{ gradeOpen ? '▾' : '▸' }}</span></button>
            <div id="color-grade-controls" :class="gradeOpen ? '' : 'disclosure-closed'">
          <section class="grading-editor" aria-label="Color Grade">
            <div class="group-title-row"><h4 class="control-section">Color Grade</h4></div>
            <p class="grading-description">Add color to shadows, midtones, highlights, or the whole image.</p>
            <div class="grading-tabs" role="tablist" aria-label="Grading range"><button #for="range in gradingRanges" type="button" role="tab" :aria-selected="gradeRange === range.index ? 'true' : 'false'" :class="gradeRange === range.index ? 'selected' : ''" :data-range="range.index" @click="selectGradeRange">{{ range.name }}</button></div>
            <div class="grading-wheel-wrap"><div class="grading-wheel" role="slider" tabindex="0" :aria-label="gradingRanges[gradeRange].name + ' color wheel'" :aria-valuenow="gradeValues[gradeRange * 3 + 1]" :aria-valuetext="gradeWheelLabel()" @pointerdown="startGradeWheel" @pointermove="moveGradeWheel" @pointerup="finishGradeWheel" @pointercancel="cancelGradeWheel" @keydown="gradeWheelKeydown"><span class="grading-wheel-center"></span><span class="grading-wheel-handle" :style="gradeWheelHandleStyle()"></span></div></div>
            <DevelopSlider :id="'grade-' + (gradeRange * 3)" :name="'Hue'" :help="'Chooses the tint color for this tonal range.'" :value="gradeValues[gradeRange * 3]" :displayValue="gradeValues[gradeRange * 3] + '°'" :min="0" :max="359" :stepAmount="5" :lowLabel="'Red'" :highLabel="'Red'" :disabled="!developAvailable" @preview="previewGrade" @commit="commitGrade" @step="stepGrade" @reset="resetGrade" @help="showHelp" @hide-help="closeHelp" />
            <DevelopSlider :id="'grade-' + (gradeRange * 3 + 1)" :name="'Strength'" :help="'Sets how much color is added to this tonal range.'" :value="gradeValues[gradeRange * 3 + 1]" :displayValue="gradeValues[gradeRange * 3 + 1] + '%'" :min="0" :max="100" :stepAmount="5" :lowLabel="'None'" :highLabel="'More'" :disabled="!developAvailable" @preview="previewGrade" @commit="commitGrade" @step="stepGrade" @reset="resetGrade" @help="showHelp" @hide-help="closeHelp" />
            <DevelopSlider :id="'grade-' + (gradeRange * 3 + 2)" :name="'Luminance'" :help="'Brightens or darkens this tonal range independently of its tint.'" :value="gradeValues[gradeRange * 3 + 2]" :displayValue="toneLabel(gradeValues[gradeRange * 3 + 2])" :min="-100" :max="100" :stepAmount="5" :lowLabel="'Darker'" :highLabel="'Brighter'" :disabled="!developAvailable" @preview="previewGrade" @commit="commitGrade" @step="stepGrade" @reset="resetGrade" @help="showHelp" @hide-help="closeHelp" />
            <DevelopSlider :id="'grade-12'" :name="'Balance'" :help="'Shifts the transition between shadow and highlight grading.'" :value="gradeValues[12]" :displayValue="toneLabel(gradeValues[12])" :min="-100" :max="100" :stepAmount="5" :lowLabel="'Shadows'" :highLabel="'Highlights'" :disabled="!developAvailable" @preview="previewGrade" @commit="commitGrade" @step="stepGrade" @reset="resetGrade" @help="showHelp" @hide-help="closeHelp" />
          </section>
            </div>
          </section>
          <p #if="hasPhoto && !developAvailable" class="availability">This photograph can be viewed. Develop controls require a qualified RAW variant.</p>
          <p #if="!hasPhoto" class="availability">Develop controls appear when a qualified photograph is open.</p>
          <div class="develop-divider" #if="hasPhoto"></div><p class="source-safety" #if="hasPhoto">Original photograph preserved</p>
        </div>
        <div id="develop-panel-detail" role="tabpanel" aria-labelledby="develop-tab-detail" :class="activeTab === 'detail' ? 'develop-content' : 'develop-content inactive'">
          <div class="group-title-row"><h3 class="group-heading">Detail</h3><button #if="developAvailable" class="reset-button" :disabled="opening || rendering || (clarityPercent === 0 && texturePercent === 0)" @click="resetDetail">Reset Detail</button></div>
          <p #if="developAvailable" class="group-description">Change the appearance of fine surface texture or broader local contrast. Inspect the photograph at a closer zoom to judge the result.</p>
          <div :class="developAvailable ? '' : 'hidden-control'"><DevelopSlider :id="'clarity'" :name="'Clarity'" :help="'Changes midscale local contrast so texture looks clearer or softer.'" :value="clarityPercent" :displayValue="toneLabel(clarityPercent)" :min="-100" :max="100" :stepAmount="10" :lowLabel="'Softer'" :highLabel="'Clearer'" :disabled="!developAvailable" @preview="previewControl" @commit="commitControlChange" @step="stepControl" @reset="resetControl" @help="showHelp" @hide-help="closeHelp" /></div>
          <div :class="developAvailable ? '' : 'hidden-control'"><DevelopSlider :id="'texture'" :name="'Texture'" :help="'Smooths or enhances fine detail while limiting changes at strong edges.'" :value="texturePercent" :displayValue="toneLabel(texturePercent)" :min="-100" :max="100" :stepAmount="10" :lowLabel="'Smoother'" :highLabel="'More texture'" :disabled="!developAvailable" @preview="previewControl" @commit="commitControlChange" @step="stepControl" @reset="resetControl" @help="showHelp" @hide-help="closeHelp" /></div>
          <p #if="hasPhoto && !developAvailable" class="availability">This photograph can be viewed. Develop controls require a qualified RAW variant.</p>
          <p #if="!hasPhoto" class="availability">Develop controls appear when a qualified photograph is open.</p>
          <div class="develop-divider" #if="hasPhoto"></div><p class="source-safety" #if="hasPhoto">Original photograph preserved</p>
        </div>
      </aside>
    </section>
    <footer class="filmstrip"><div class="filmstrip-content"><div :class="hasPhoto ? 'filmstrip-tile' : 'filmstrip-tile hidden-control'" :aria-hidden="hasPhoto ? 'false' : 'true'" :aria-label="photoName || 'Open photograph'"><span id="filmstrip-preview" class="tile-image"></span></div><span class="filmstrip-name" #if="photoName !== ''" :title="photoName">{{ photoName }}</span></div></footer>
  </main>
</template>
<script lang="ts">
  import DevelopSlider from "./components/domain/DevelopSlider.weiv";
  import HslMixerRow from "./components/domain/HslMixerRow.weiv";
  import PhotoZoomControls from "./components/domain/PhotoZoomControls.weiv";
  import { cancelOpen, cancelExport, documentSnapshot, exportStatus, exportTiff as startTiffExport, undoEdit, redoEdit, commitGeometry, commitTransform, hslValue, setHsl, curveValue, setCurve, gradeValue, setGrade, setGradeWheel, setPickedColor, setAdjustment, pickColorFromPhoto, showPickMask, setCropTool, setCropRatio, newWindow as createWindow, openPhoto, openProject as openSavedProject, saveProject as saveCurrentProject, resetLight as resetLightCommand, resetColor as resetColorCommand, resetDetail as resetDetailCommand, setPreviewDisplay, setPreviewZoom, setClarity, setTexture, setColor, setContrast, setExposure, setTone, showFilmstripPreview, showHistogram, showNavigatorPreview, showPreview } from "./generated/commands.ts";
  import { attachNativeSlot } from "neiv/slots";
  import { events } from "./generated/events.ts";
  // Weiv manages these bindings directly. Assignments from handlers, promises,
  // timers, and event subscriptions notify the page without an update wrapper.
  let hasPhoto = false;
  let photoName = '';
  let opening = false;
  let cancellableOpening = false;
  let rendering = false;
  let previewFailure = '';
  let saving = false;
  let exporting = false;
  let comparisonMode = 0;
  let proofProfile = 0;
  let zoomPercent = 0;
  let sourceDetailReady = false;
  async function setZoom(percent: number) {
    if (await setPreviewZoom(percent)) { zoomPercent = percent; }
  }
  let zoomFrame = 0;
  function previewZoom(percent: number) {
    if (zoomFrame) cancelAnimationFrame(zoomFrame);
    zoomFrame = requestAnimationFrame(() => { zoomFrame = 0; void setZoom(percent); });
  }
  async function setComparison(mode: number) {
    if (await setPreviewDisplay(mode, proofProfile)) { comparisonMode = mode; }
  }
  async function changeProof(event: Event) {
    const select = event.target as HTMLSelectElement;
    const profile = Number(select.value);
    if (await setPreviewDisplay(comparisonMode, profile)) { proofProfile = profile; }
    else select.value = String(proofProfile);
  }
  events.subscribe("lightcept.zoom", event => { zoomPercent = event.percent; });
  events.subscribe("lightcept.detail", event => { sourceDetailReady = event.ready; });
  events.subscribe("lightcept.color_pick", event => { void finishColorPick(event.hue); });
  let cropMode = false;
  let cropDraft: { left: number; top: number; width: number; height: number } | null = null;
  let cropAngle = 0;
  let cropRatio = 0;
  let cropAngleChanged = false;
  events.subscribe("lightcept.crop", event => {
    cropDraft = { left: event.left, top: event.top, width: event.width, height: event.height };
    if (!cropAngleChanged) cropAngle = event.angleMillidegrees;
  });
  async function toggleCrop() {
    const enabled = !cropMode;
    if (enabled) await setCropRatio(0);
    if (await setCropTool(enabled ? 1 : 0)) { cropMode = enabled; cropRatio = 0; cropAngleChanged = false; if (!enabled) cropDraft = null; }
  }
  async function closeCrop() {
    if (await setCropTool(0)) { cropMode = false; cropDraft = null; cropAngleChanged = false; }
  }
  async function changeCropRatio(event: Event) {
    const select = event.target as HTMLSelectElement;
    const preset = Number(select.value);
    if (await setCropRatio(preset)) { cropRatio = preset; }
    else select.value = String(cropRatio);
  }
  function changeCropAngle(event: Event) {
    const value = Number((event.target as HTMLInputElement).value);
    cropAngle = Math.round(value * 1000); cropAngleChanged = true;
  }
  async function changeOrientation(event: Event) {
    const select = event.target as HTMLSelectElement;
    const code = Number(select.value);
    const selected = cropDraft;
    if (!selected || !code || opening) return;
    const before = await documentSnapshot();
    opening = true; status = "Applying orientation…";
    try {
      const result = await commitTransform(code, selected.left, selected.top, selected.width, selected.height, cropAngle);
      if (result === 1) {
        await followOpen(before.committedGeneration, before.editRevision, "Orientation");
        const after = await documentSnapshot();
        if (after.committedGeneration !== before.committedGeneration) await closeCrop();
      } else { status = "Could not apply orientation"; }
    } catch (error) {
      status = (error as Error).message;
    } finally {
      select.value = "0";
      opening = false;
    }
  }
  async function applyCrop() {
    const selected = cropDraft;
    if (!selected || opening) return;
    const before = await documentSnapshot();
    opening = true; status = "Applying crop…";
    try {
      if (await commitGeometry(selected.left, selected.top, selected.width, selected.height, cropAngle)) {
        await followOpen(before.committedGeneration, before.editRevision, "Crop");
        const after = await documentSnapshot();
        if (after.committedGeneration !== before.committedGeneration) await closeCrop();
      } else { status = "Could not apply crop"; }
    } catch (error) {
      status = (error as Error).message;
    } finally { opening = false; }
  }

  let activeTab: 'light' | 'color' | 'detail' = 'light';
  let helpText = '';
  function showHelp(message: string) { helpText = message; }
  function closeHelp() { helpText = ''; }
  function selectTab(tab: 'light' | 'color' | 'detail') { activeTab = tab; helpText = ''; }
  function onTabKeydown(event: KeyboardEvent) {
    const tabs: ('light' | 'color' | 'detail')[] = ['light', 'color', 'detail'];
    const current = tabs.indexOf(activeTab);
    let next = current;
    if (event.key === 'ArrowRight') next = (current + 1) % tabs.length;
    else if (event.key === 'ArrowLeft') next = (current + tabs.length - 1) % tabs.length;
    else if (event.key === 'Home') next = 0;
    else if (event.key === 'End') next = tabs.length - 1;
    else return;
    event.preventDefault();
    const tab = tabs[next];
    selectTab(tab);
    document.getElementById(`develop-tab-${tab}`)?.focus();
  }
  let exposureTenths = 0;
  let contrastPercent = 0;
  let shadowsPercent = 0;
  let highlightsPercent = 0;
  let blacksPercent = 0;
  let whitesPercent = 0;
  let warmthPercent = 0;
  let tintPercent = 0;
  let vibrancePercent = 0;
  let saturationPercent = 0;
  let clarityPercent = 0;
  let texturePercent = 0;
  type HslRow = { band: number; kind: number; name: string; ariaLabel: string; swatchClass: string; value: number; display: string };
  const hslBandNames = ["Red", "Orange", "Yellow green", "Spring green", "Cyan", "Azure", "Violet", "Rose"];
  const hslKindNames = ["Hue", "Saturation", "Luminance"];
  const hslBands = hslBandNames.map((name, index) => ({ index, name, swatchClass: `hsl-swatch hsl-swatch-${index}` }));
  let hslLayout = 'color';
  let colorMode: 'groups' | 'picked' = 'picked';
  let curvesOpen = false;
  let moreColorOpen = false;
  let gradeOpen = false;
  function toggleCurves() { curvesOpen = !curvesOpen; if (curvesOpen) queueCurveDraw(); }
  function toggleMoreColor() { moreColorOpen = !moreColorOpen; }
  function toggleGrade() { gradeOpen = !gradeOpen; }
  function gradingChanged(): boolean { return gradeValues.slice(0, 13).some(value => value !== 0); }
  function selectColorMode(mode: 'groups' | 'picked') {
    if (mode !== 'picked' && pickingColor) { void pickColorFromPhoto(0); pickingColor = false; }
    if (mode !== 'picked' && showAffected) void showPickMask(0, gradeValues[13], gradeValues[14] || 20, gradeValues[15] || 50);
    if (mode === 'picked' && showAffected) void updateAffected();
    colorMode = mode;
  }
  let hslMode = 0;
  let hslSelectedBand = 0;
  let hslValues = Array(24).fill(0) as number[];
  const gradingRanges = [{ index: 0, name: 'Shadows' }, { index: 1, name: 'Midtones' }, { index: 2, name: 'Highlights' }, { index: 3, name: 'Global' }];
  let gradeRange = 0;
  let pickingColor = false;
  let showAffected = false;
  async function updateAffected() {
    await showPickMask(showAffected && colorMode === 'picked' ? 1 : 0,
      gradeValues[13], gradeValues[14] || 20, gradeValues[15] || 50);
  }
  async function toggleAffected() {
    showAffected = !showAffected;
    await updateAffected();
  }
  async function startColorPick() {
    const next = !pickingColor;
    if (await pickColorFromPhoto(next ? 1 : 0)) { pickingColor = next; }
  }
  async function finishColorPick(hue: number) {
    pickingColor = false;
    if (!Number.isInteger(hue) || hue < 0 || hue >= 360 || opening) return;
    const values = gradeValues.slice(); values[13] = hue; values[19] = 1; gradeValues = values;
    const before = await documentSnapshot();
    opening = true; status = 'Selecting color…';
    try {
      if (await submitAdjustment(5, 0, hue, 0)) scheduleEditCompletion(before.committedGeneration, before.editRevision, 'Picked color');
      else { status = 'Could not select color'; }
    } catch (error) { status = (error as Error).message; }
    finally { opening = false; await updateAffected(); }
  }
  let gradeValues = Array(20).fill(0) as number[];
  let gradePointerId = -1;
  let gradeDragStart = [0, 0];
  let hslRows: HslRow[] = [];
  let hslColorRows: HslRow[] = [];
  type CurveRow = { id: string; name: string; help: string; value: number; neutral: number; display: string; min: number; max: number };
  const curveChannels = [{ index: 3, name: 'Luma' }, { index: 0, name: 'Red' }, { index: 1, name: 'Green' }, { index: 2, name: 'Blue' }];
  const curveNames = ['Shadows', 'Midtones', 'Highlights'];
  let curveChannel = 3;
  let curveValues = [250, 500, 750, 250, 500, 750, 250, 500, 750, 250, 500, 750];
  function curvesChanged(): boolean { return curveValues.some((value, index) => value !== (index % 3 + 1) * 250); }
  let curveRows: CurveRow[] = [];
  let curvePoints: { x: number; y: number }[] = [];
  let curveDrawQueued = false;
  let curveDraggingPoint = -1;
  let curvePointerId = -1;
  let curveDragStartValue = 0;
  let hslRefresh = 0;
  function curveRowsFor(values: number[], channel: number): CurveRow[] {
    return curveNames.map((name, point) => {
      const offset = channel * 3 + point;
      const value = values[offset];
      return { id: `curve-${channel}-${point}`, name, help: `Sets the ${name.toLowerCase()} output of the ${channel === 3 ? 'luma' : ['red', 'green', 'blue'][channel]} curve.`,
        value, neutral: (point + 1) * 250, display: `${(value / 10).toFixed(1)}%`, min: point === 0 ? 0 : values[offset - 1], max: point === 2 ? 1000 : values[offset + 1] };
    });
  }
  function curvePointsFor(values: number[], channel: number) {
    return [0, 1, 2].map(point => ({ x: (point + 1) * 50, y: 200 - values[channel * 3 + point] / 5 }));
  }
  function curveGraphLabel(): string { return `${curveChannels.find(channel => channel.index === curveChannel)?.name ?? 'Tone'} curve from black to white`; }
  function smoothCurveOutput(outputs: number[], x: number): number {
    const segment = Math.min(3, Math.floor(x * 4));
    const slopes = [0, 1, 2, 3].map(i => (outputs[i + 1] - outputs[i]) * 4);
    const tangent = (i: number): number => {
      if (i === 0 || i === 4) {
        const edge = i === 0 ? slopes[0] : slopes[3];
        const neighbor = i === 0 ? slopes[1] : slopes[2];
        return Math.max(0, Math.min(3 * edge, (3 * edge - neighbor) / 2));
      }
      const a = slopes[i - 1], b = slopes[i];
      return a <= 0 || b <= 0 ? 0 : 2 * a * b / (a + b);
    };
    const t = x * 4 - segment, t2 = t * t, t3 = t2 * t;
    return (2 * t3 - 3 * t2 + 1) * outputs[segment]
      + (t3 - 2 * t2 + t) * tangent(segment) / 4
      + (-2 * t3 + 3 * t2) * outputs[segment + 1]
      + (t3 - t2) * tangent(segment + 1) / 4;
  }
  function drawCurveGraph() {
    const canvas = document.getElementById('curve-graph') as HTMLCanvasElement | null;
    const context = canvas?.getContext('2d');
    if (!context) return;
    context.clearRect(0, 0, 200, 200);
    context.fillStyle = '#141b17'; context.fillRect(0, 0, 200, 200);
    context.strokeStyle = '#344038'; context.lineWidth = 1;
    for (const position of [50, 100, 150]) {
      context.beginPath(); context.moveTo(position, 0); context.lineTo(position, 200); context.stroke();
      context.beginPath(); context.moveTo(0, position); context.lineTo(200, position); context.stroke();
    }
    context.strokeStyle = '#647669'; context.setLineDash([3, 4]);
    context.beginPath(); context.moveTo(0, 200); context.lineTo(200, 0); context.stroke();
    context.setLineDash([]);
    const color = ['#d77979', '#75bd87', '#7da4d8', '#e8eee3'][curveChannel];
    context.strokeStyle = color; context.lineWidth = 2;
    const outputs = [0, ...curveValues.slice(curveChannel * 3, curveChannel * 3 + 3).map(value => value / 1000), 1];
    context.beginPath(); context.moveTo(0, 200);
    for (let pixel = 1; pixel <= 200; pixel++)
      context.lineTo(pixel, 200 * (1 - smoothCurveOutput(outputs, pixel / 200)));
    context.stroke();
    context.fillStyle = color; context.strokeStyle = '#e8eee3'; context.lineWidth = 1;
    for (const point of curvePoints) {
      context.beginPath(); context.arc(point.x, point.y, 6, 0, Math.PI * 2);
      context.fill(); context.stroke();
    }
  }
  function queueCurveGraph() {
    if (curveDrawQueued) return;
    curveDrawQueued = true;
    requestAnimationFrame(() => { curveDrawQueued = false; drawCurveGraph(); });
  }
  function curveGraphPosition(event: PointerEvent): { x: number; y: number } {
    const rect = (event.currentTarget as HTMLCanvasElement).getBoundingClientRect();
    return { x: (event.clientX - rect.left) * 200 / rect.width,
      y: (event.clientY - rect.top) * 200 / rect.height };
  }
  function updateCurveFromPointer(event: PointerEvent) {
    if (curveDraggingPoint < 0 || event.pointerId !== curvePointerId) return;
    const y = curveGraphPosition(event).y;
    const row = curveRowsFor(curveValues, curveChannel)[curveDraggingPoint];
    const value = Math.max(row.min, Math.min(row.max, Math.round((200 - y) * 5)));
    previewCurve({ id: row.id, value });
  }
  function startCurveDrag(event: PointerEvent) {
    if (opening || curveDraggingPoint >= 0) return;
    const position = curveGraphPosition(event);
    const point = Math.round(position.x / 50) - 1;
    if (point < 0 || point > 2 || Math.abs(position.x - (point + 1) * 50) > 14 ||
      Math.abs(position.y - curvePoints[point].y) > 14) return;
    curveDraggingPoint = point;
    curvePointerId = event.pointerId;
    curveDragStartValue = curveValues[curveChannel * 3 + point];
    (event.currentTarget as HTMLCanvasElement).setPointerCapture(event.pointerId);
    event.preventDefault();
    updateCurveFromPointer(event);
  }
  function moveCurveDrag(event: PointerEvent) { updateCurveFromPointer(event); }
  async function finishCurveDrag(event: PointerEvent) {
    if (curveDraggingPoint < 0 || event.pointerId !== curvePointerId) return;
    updateCurveFromPointer(event);
    const point = curveDraggingPoint;
    const value = curveValues[curveChannel * 3 + point];
    curveDraggingPoint = -1;
    curvePointerId = -1;
    if ((event.currentTarget as HTMLCanvasElement).hasPointerCapture(event.pointerId))
      (event.currentTarget as HTMLCanvasElement).releasePointerCapture(event.pointerId);
    if (value !== curveDragStartValue)
      await commitCurve({ id: `curve-${curveChannel}-${point}`, value });
  }
  function cancelCurveDrag(event: PointerEvent) {
    if (curveDraggingPoint < 0 || event.pointerId !== curvePointerId) return;
    previewCurve({ id: `curve-${curveChannel}-${curveDraggingPoint}`, value: curveDragStartValue });
    curveDraggingPoint = -1;
    curvePointerId = -1;
  }
  function selectCurveChannel(event: Event) {
    const channel = Number((event.currentTarget as HTMLElement).dataset.channel);
    if (!Number.isInteger(channel) || channel < 0 || channel > 3) return;
    curveChannel = channel; curveRows = curveRowsFor(curveValues, channel); curvePoints = curvePointsFor(curveValues, channel);
    queueCurveGraph();
  }
  function curveLocation(id: string): { channel: number; point: number } | undefined {
    const match = /^curve-([0-3])-([0-2])$/.exec(id);
    if (!match) return undefined;
    return { channel: Number(match[1]), point: Number(match[2]) };
  }
  function previewCurve(change: SliderChange) {
    const location = curveLocation(change.id);
    if (!location) return;
    const values = curveValues.slice(); values[location.channel * 3 + location.point] = change.value;
    curveValues = values; curvePoints = curvePointsFor(values, curveChannel);
    queueCurveGraph();
  }
  async function commitCurve(change: SliderChange) {
    const location = curveLocation(change.id);
    if (!location || !developAvailable) return;
    previewCurve(change);
    curveRows = curveRowsFor(curveValues, curveChannel);
    ++latestEditToken;
    const before = await documentSnapshot();
    status = 'Updating RGB curve…';
    try {
      if (await submitAdjustment(2, location.channel * 3 + location.point, change.value, 0)) scheduleEditCompletion(before.committedGeneration, before.editRevision, 'RGB curve');
      else { status = 'Could not update RGB curve'; }
    } catch (error) {
      status = (error as Error).message;
    }
  }
  async function stepCurve(change: SliderStep) {
    const location = curveLocation(change.id);
    if (!location) return;
    const row = curveRowsFor(curveValues, location.channel)[location.point];
    await commitCurve({ id: change.id, value: Math.max(row.min, Math.min(row.max, row.value + change.delta)) });
  }
  async function resetCurvePoint(id: string) {
    const location = curveLocation(id);
    if (!location) return;
    const row = curveRowsFor(curveValues, location.channel)[location.point];
    await commitCurve({ id, value: Math.max(row.min, Math.min(row.max, (location.point + 1) * 250)) });
  }
  function hslDisplay(value: number, kind: number): string {
    return kind === 0 ? `${(value * 0.45).toFixed(1)}°` : `${value}%`;
  }
  function hslBandChanged(band: number): boolean {
    return hslValues[band] !== 0 || hslValues[8 + band] !== 0 || hslValues[16 + band] !== 0;
  }
  function mixerRows(values: number[], mode: number): HslRow[] {
    return hslBandNames.map((name, band) => {
      const value = values[mode * 8 + band];
      return { band, kind: mode, name, ariaLabel: `${name} ${hslKindNames[mode]}`,
        swatchClass: `hsl-swatch hsl-swatch-${band}`,
        value, display: hslDisplay(value, mode) };
    });
  }
  function colorRows(values: number[], band: number): HslRow[] {
    return hslKindNames.map((name, kind) => {
      const value = values[kind * 8 + band];
      return { band, kind, name, ariaLabel: `${hslBandNames[band]} ${name}`,
        swatchClass: `hsl-swatch hsl-swatch-${band}`,
        value, display: hslDisplay(value, kind) };
    });
  }
  function selectHslLayout(layout: string) {
    if (layout !== 'adjustment' && layout !== 'color') return;
    hslLayout = layout;
  }
  function selectHslMode(mode: number) {
    if (mode < 0 || mode > 2) return;
    hslMode = mode;
    hslRows = mixerRows(hslValues, mode);
  }
  function selectHslColor(event: Event) {
    const band = hslBandFromEvent(event);
    if (!Number.isInteger(band) || band < 0 || band > 7) return;
    hslSelectedBand = band; hslColorRows = colorRows(hslValues, band);
  }
  async function refreshHslRows() {
    if (!developAvailable) return;
    const refresh = ++hslRefresh;
    const values = await Promise.all(Array.from({ length: 24 }, (_, index) =>
      hslValue(Math.floor(index / 8), index % 8)));
    const curves = await Promise.all(Array.from({ length: 12 }, (_, index) =>
      curveValue(Math.floor(index / 3), index % 3)));
    const grades = await Promise.all(Array.from({ length: 20 }, (_, index) => gradeValue(index)));
    if (refresh !== hslRefresh) return;
    hslValues = values; hslRows = mixerRows(values, hslMode); hslColorRows = colorRows(values, hslSelectedBand);
    curveValues = curves; curveRows = curveRowsFor(curves, curveChannel); curvePoints = curvePointsFor(curves, curveChannel);
    gradeValues = grades;
    queueCurveGraph();
  }
  function hslBandFromEvent(event: Event): number {
    return Number((event.currentTarget as HTMLElement).dataset.band);
  }
  type HslChange = { band: number; kind: number; value: number };
  type HslStep = { band: number; kind: number; delta: number };
  type HslTarget = { band: number; kind: number };
  function validHslTarget(band: number, kind: number): boolean {
    return Number.isInteger(band) && band >= 0 && band <= 7 && Number.isInteger(kind) && kind >= 0 && kind <= 2;
  }
  function previewHslRow({ band, kind, value }: HslChange) {
    if (!validHslTarget(band, kind)) return;
    const values = hslValues.slice(); values[kind * 8 + band] = value;
    hslValues = values;
