  async function resetLight() {
    if (opening || !developAvailable || !lightChanged()) return;
    const before = await documentSnapshot();
    opening = true; status = "Resetting light…";
    try {
      if (await resetLightCommand()) await followOpen(before.committedGeneration, before.editRevision, "Light");
      else { status = "Could not reset light"; }
    } catch (error) {
      status = (error as Error).message;
    } finally { opening = false; }
  }
  async function moveHistory(command: () => Promise<boolean>, label: string) {
    if (opening || !developAvailable) return;
    const before = await documentSnapshot();
    opening = true; status = `${label}…`;
    try {
      if (await command()) {
        await followOpen(before.committedGeneration, before.editRevision, label);
        const after = await documentSnapshot();
        if (after.committedGeneration !== before.committedGeneration) status = `${label} restored`;
      }
      else { status = `Could not ${label.toLowerCase()}`; }
    } catch (error) {
      status = (error as Error).message;
    } finally {
      opening = false;
    }
  }
  async function undo() { await moveHistory(undoEdit, "Earlier edit"); }
  async function redo() { await moveHistory(redoEdit, "Later edit"); }
  async function cancel() {
    await cancelOpen();
  }
  async function newWindow() {
    if (!await createWindow()) { status = "Could not open a new window"; }
  }
  documentSnapshot().then(async snapshot => {
    hasPhoto = snapshot.hasPhoto; photoName = snapshot.hasPhoto ? snapshot.sourceName : ''; canUndo = snapshot.canUndo; canRedo = snapshot.canRedo; historyLength = snapshot.historyLength; historyCursor = snapshot.historyCursor; developAvailable = snapshot.exposureAvailable; exposureTenths = snapshot.exposureTenths; contrastPercent = snapshot.contrastPercent; shadowsPercent = snapshot.shadowsPercent; highlightsPercent = snapshot.highlightsPercent;
    blacksPercent = snapshot.blacksPercent;
    whitesPercent = snapshot.whitesPercent;
    warmthPercent = snapshot.warmthPercent; tintPercent = snapshot.tintPercent; vibrancePercent = snapshot.vibrancePercent; saturationPercent = snapshot.saturationPercent; clarityPercent = snapshot.clarityPercent; texturePercent = snapshot.texturePercent; status = snapshot.failureCode ? failureMessage(snapshot.failureCode) : '';
    if (snapshot.hasPhoto) { await attachPreview(); await refreshHslRows(); }
    if (snapshot.phase === PHASE_OPENING) {
      opening = true; cancellableOpening = true; status = "Opening…";
      try { await followOpen(snapshot.committedGeneration, snapshot.editRevision); }
      finally { opening = false; cancellableOpening = false; }
    }
  });
  async function open() {
    if (opening) return;
    opening = true; cancellableOpening = true; status = "Opening…";
    try {
      const before = await documentSnapshot();
      const scheduled = await openPhoto({ deadlineMs: 30000 });
      if (scheduled) await followOpen(before.committedGeneration, before.editRevision);
      else {
        const snapshot = await documentSnapshot();
        hasPhoto = snapshot.hasPhoto; status = failureMessage(snapshot.failureCode);
      }
    } catch (error) {
      status = (error as Error).message;
    } finally {
      opening = false; cancellableOpening = false;
    }
  }
  async function openProject() {
    if (opening || saving) return;
    opening = true; cancellableOpening = true; status = "Opening project…";
    try {
      const before = await documentSnapshot();
      if (await openSavedProject()) {
        await followOpen(before.committedGeneration, before.editRevision);
        const after = await documentSnapshot();
        if (after.committedGeneration !== before.committedGeneration) status = "Project opened";
      } else { status = "Could not start project open"; }
    } catch (error) {
      status = (error as Error).message;
    } finally { opening = false; cancellableOpening = false; }
  }
  async function saveProject() {
    if (opening || saving || !developAvailable) return;
    saving = true; status = "Choose where to save the project…";
    try {
      if (!await saveCurrentProject()) {
        status = "Could not start project save";
        return;
      }
      for (;;) {
        const snapshot = await documentSnapshot();
        if (snapshot.projectStatus !== PROJECT_SAVING) {
          const message = snapshot.projectStatus === PROJECT_SAVED ? "Project saved" :
            snapshot.projectStatus === PROJECT_CANCELLED ? "Save cancelled" :
            snapshot.projectStatus === PROJECT_CHANGED_SOURCE ? "Original photograph changed; project was not saved" :
            "Could not save project";
          status = message;
          return;
        }
        await new Promise(resolve => setTimeout(resolve, 100));
      }
    } catch (error) {
      status = (error as Error).message;
    } finally { saving = false; }
  }
  async function exportTiff() {
    if (opening || saving || exporting || !developAvailable) return;
    exporting = true; status = "Choose where to export the TIFF…";
    try {
      if (!await startTiffExport()) {
        status = "Could not start TIFF export";
        return;
      }
      for (;;) {
        const result = await exportStatus();
        if (result === 6) { status = "Rendering full-resolution TIFF…"; }
        if (result !== 1 && result !== 6) {
          const message = result === 2 ? "Full-resolution TIFF exported" :
            result === 3 ? "Export cancelled" :
            result === 5 ? "Original photograph changed; TIFF was not exported" :
            "Could not export TIFF";
          status = message;
          return;
        }
        await new Promise(resolve => setTimeout(resolve, 250));
      }
    } catch (error) {
      status = (error as Error).message;
    } finally { exporting = false; }
  }
  async function cancelTiffExport() { await cancelExport(); }
</script>
<style>
  * { box-sizing: border-box; }
  :global(html), :global(body) { width: 100%; height: 100%; margin: 0; overflow: hidden; background: #171c1a; }
  .app { height: 100vh; width: 100%; display: flex; flex-direction: column; overflow: hidden; background: #171c1a; color: #d8ded7; font: 13px -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif; }
  button { font: inherit; cursor: pointer; }
  button:disabled { cursor: default; opacity: .45; }
  button:focus-visible, input:focus-visible { outline: 2px solid #d2e5bd; outline-offset: 2px; }
  .topbar { height: 52px; flex: 0 0 52px; display: flex; align-items: center; justify-content: space-between; padding: 0 17px; border-bottom: 1px solid #303832; background: #171c19; }
  .identity { min-width: 0; display: flex; align-items: center; gap: 15px; }
  .brand { font-size: 18px; font-weight: 650; letter-spacing: .21em; color: #e9eee5; }
  .photo-name { max-width: 220px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; color: #9ead9e; font-size: 11px; }
  .header-actions { min-width: 0; margin-left: auto; display: flex; align-items: center; gap: 8px; }
  .header-status { min-width: 0; max-width: 210px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; color: #aebead; font-size: 11px; }
  .open-button, .quiet-button { border-radius: 4px; padding: 7px 11px; font-size: 11px; }
  .open-button { border: 1px solid #bfd1ad; background: #c5d5b5; color: #1d291e; font-weight: 600; }
  .open-button:hover:enabled { background: #d5e1ca; }
  .quiet-button { border: 1px solid #3b4740; background: #252d28; color: #c9d3c8; }
  .quiet-button:hover:enabled { background: #334037; }
  .workspace { min-height: 0; flex: 1; display: grid; grid-template-columns: 170px minmax(320px, 1fr) 285px; }
  .navigator { min-width: 0; padding: 13px 10px; border-right: 1px solid #303832; background: #1a201c; }
  .section-heading, .group-heading { margin: 0; font-size: 12px; font-weight: 600; color: #d8e0d2; }
  .section-heading { margin: 0 2px 12px; }
  .navigator-frame { position: relative; aspect-ratio: 1.48; border: 1px solid #39453d; border-radius: 4px; background: #101512; display: grid; place-items: center; overflow: hidden; color: #748679; font-size: 10px; }
  .navigator-preview { position: absolute; inset: 0; }
  .source-note { margin: 9px 1px 16px; color: #738979; font-size: 9px; line-height: 1.4; letter-spacing: .04em; }
  .navigator-group { padding-top: 14px; }
  .navigator-group h3 { margin: 0 3px 10px; color: #839787; font-size: 9px; font-weight: 600; text-transform: uppercase; letter-spacing: .07em; }
  .edits-group { margin-top: 18px; border-top: 1px solid #354139; }
  .edit-position { margin: 3px 3px 10px; color: #b7c9b5; font-size: 11px; }
  .edit-actions { display: flex; gap: 6px; padding: 0 3px; }
  .edit-actions button { flex: 1; min-width: 0; padding: 6px 4px; font-size: 10px; }
  .editor { min-width: 0; min-height: 0; display: flex; flex-direction: column; background: #101411; }
  .crop-panel { flex: 0 0 auto; display: flex; flex-wrap: wrap; justify-content: center; align-items: center; gap: 10px; padding: 9px 12px; background: #1b221ef2; color: #dce4d8; border: 1px solid #596653; border-radius: 7px; font-size: 11px; z-index: 2; }
  .crop-panel label { display: flex; align-items: center; gap: 6px; }
  .crop-panel select { background: #29362c; color: #edf3e9; border: 1px solid #657963; border-radius: 4px; padding: 4px; }
  .crop-panel button { background: #354837; color: #edf3e9; border: 1px solid #657963; border-radius: 4px; padding: 5px 9px; }
  .color-methods { display: grid; grid-template-columns: repeat(2, 1fr); gap: 2px; margin: 18px 0 8px; padding: 2px; border: 1px solid #3c4c40; border-radius: 5px; background: #141b17; }
  .color-methods button { min-width: 0; padding: 8px 2px; border: 0; border-radius: 3px; color: #9cad9c; background: transparent; font-size: 10px; }
  .color-methods button.selected { color: #e4efdc; background: #354735; }
  .color-methods button:focus-visible { outline: 2px solid #c6d8b6; outline-offset: 2px; }
  .hsl-editor { margin-top: 8px; padding-top: 8px; }
  .hsl-heading { display: flex; justify-content: space-between; align-items: center; gap: 8px; margin-bottom: 10px; }
  .hsl-view-label { color: #9db39c; font-size: 10px; }
  .hsl-layouts { display: flex; align-items: center; padding: 2px; border: 1px solid #3c4c40; border-radius: 5px; background: #141b17; }
  .hsl-layouts button { display: grid; place-items: center; width: 28px; height: 24px; padding: 0; border: 0; border-radius: 3px; color: #aabbab; background: transparent; cursor: pointer; }
  .hsl-layouts button[aria-pressed="true"] { color: #e4efdc; background: #354735; }
  .layout-adjustment-icon { display: grid; gap: 3px; width: 16px; }
  .layout-adjustment-icon i { position: relative; display: block; height: 1px; background: currentColor; }
  .layout-adjustment-icon i::after { position: absolute; top: -2px; left: 3px; width: 5px; height: 5px; border-radius: 1px; background: currentColor; content: ''; }
  .layout-adjustment-icon i:nth-child(2)::after { left: 10px; }
  .layout-adjustment-icon i:nth-child(3)::after { left: 6px; }
  .layout-color-icon { display: flex; gap: 2px; }
  .layout-color-icon i { display: block; width: 5px; height: 12px; border-radius: 3px; background: #d77979; }
  .layout-color-icon i:nth-child(2) { background: #75bd87; }
  .layout-color-icon i:nth-child(3) { background: #7da4d8; }
  .hsl-modes { display: grid; grid-template-columns: repeat(3, 1fr); gap: 2px; padding: 2px; border: 1px solid #3c4c40; border-radius: 5px; background: #141b17; }
  .hsl-modes button { min-width: 0; padding: 7px 2px; border: 0; border-radius: 3px; color: #9cad9c; background: transparent; font-size: 11px; }
  .hsl-modes button.selected { background: #354735; color: #e4efdc; }
  .hsl-modes button:focus-visible { outline: 2px solid #c6d8b6; outline-offset: 2px; }
  .hsl-layouts button:focus-visible, .hsl-color-choices button:focus-visible { outline: 2px solid #c6d8b6; outline-offset: 2px; }
  .hsl-color-choices { display: grid; grid-template-columns: repeat(2, 1fr); gap: 5px; }
  .hsl-color-choices button { display: flex; align-items: center; gap: 6px; min-width: 0; padding: 6px; border: 1px solid #3c4c40; border-radius: 4px; color: #bacbbb; background: #141b17; font-size: 10px; text-align: left; }
  .hsl-color-choices button[aria-pressed="true"] { border-color: #8aa184; color: #edf4e9; background: #354735; }
  .hsl-edited { width: 5px; height: 5px; margin-left: auto; border-radius: 50%; background: #c5d9ac; }
  .hsl-rows { padding-top: 4px; }
  .hsl-swatch { width: 11px; height: 11px; flex: 0 0 11px; border: 1px solid #ffffff55; border-radius: 50%; }
  .hsl-swatch-0 { background: #d55a62; } .hsl-swatch-1 { background: #d48a48; }
  .hsl-swatch-2 { background: #b5c750; } .hsl-swatch-3 { background: #56bf72; }
  .hsl-swatch-4 { background: #4bbcb3; } .hsl-swatch-5 { background: #5b91d2; }
  .hsl-swatch-6 { background: #9170ca; } .hsl-swatch-7 { background: #c36b9d; }
  .hsl-note { margin: 10px 0 0; color: #829684; font-size: 10px; line-height: 1.35; }
  .picked-editor, .grading-editor { margin-top: 8px; padding-top: 8px; }
  .picked-editor .control-section { margin: 0; padding: 0; border: 0; }
  .pick-color-button { width: 100%; margin: 2px 0 8px; }
  .grading-editor .control-section { margin: 0; padding: 0; border: 0; }
  .grading-description { margin: 9px 0 12px; color: #839587; font-size: 11px; line-height: 1.4; }
  .grading-tabs { display: grid; grid-template-columns: repeat(4, 1fr); gap: 2px; padding: 2px; border: 1px solid #3c4c40; border-radius: 5px; background: #141b17; }
  .grading-tabs button { min-width: 0; padding: 7px 1px; border: 0; border-radius: 3px; color: #9cad9c; background: transparent; font-size: 10px; }
  .grading-tabs button.selected { color: #e4efdc; background: #354735; }
  .grading-tabs button:focus-visible, .grading-wheel:focus-visible { outline: 2px solid #c6d8b6; outline-offset: 2px; }
  .grading-wheel-wrap { display: flex; justify-content: center; padding: 16px 0 8px; }
  .grading-wheel { position: relative; width: 116px; height: 116px; border: 1px solid #738874; border-radius: 50%; background: radial-gradient(circle, #b5bdb3 0, #b5bdb3 4%, transparent 72%), conic-gradient(from 90deg, #d55a62, #d4b84d, #56bf72, #4bbcb3, #5b91d2, #9170ca, #d55a62); cursor: crosshair; touch-action: none; }
  .grading-wheel-center { position: absolute; inset: 12%; border-radius: 50%; background: radial-gradient(circle, #a7aaa4 0, #a7aaa4 4%, #a7aaa400 72%); pointer-events: none; }
  .grading-wheel-handle { position: absolute; width: 12px; height: 12px; border: 2px solid #f0f4ea; border-radius: 50%; background: #223027; box-shadow: 0 1px 5px #0008; transform: translate(-50%, -50%); pointer-events: none; }
  .curve-editor { margin-top: 12px; padding: 4px 10px; border: 1px solid #435447; border-left: 3px solid #829d79; border-radius: 5px; background: #222d25; }
  .disclosure-button { width: 100%; display: flex; justify-content: space-between; align-items: center; margin: 12px 0; padding: 8px 2px; border: 0; background: transparent; color: #c4d5bd; font: inherit; font-size: 11px; font-weight: 600; text-align: left; cursor: pointer; }
  .disclosure-button:focus-visible { outline: 2px solid #c6d8b6; outline-offset: 2px; }
  .disclosure-closed { display: none; }
  .curve-editor .control-section { margin-bottom: 8px; border: 0; padding: 0; }
  .curve-description { margin: 0 0 12px; color: #839587; font-size: 11px; line-height: 1.4; }
  .curve-channels { display: grid; grid-template-columns: repeat(4, 1fr); gap: 2px; margin-bottom: 11px; padding: 2px; border: 1px solid #3c4c40; border-radius: 5px; background: #141b17; }
  .curve-channels button { padding: 7px 2px; border: 0; border-radius: 3px; color: #9cad9c; background: transparent; font-size: 11px; }
  .curve-channels button.selected { background: #354735; color: #e4efdc; }
  .curve-graph { display: block; width: 220px; max-width: 100%; height: 220px; margin: 0 auto 16px; border: 1px solid #3c4c40; background: #141b17; touch-action: none; cursor: crosshair; }
  .curve-sliders { padding-top: 4px; }
  .editor-toolbar { height: 40px; flex: 0 0 40px; display: flex; align-items: center; gap: 9px; padding: 0 12px; border-bottom: 1px solid #252c27; background: #1b221e; }
  .proof-choice { margin-left: auto; display: flex; align-items: center; gap: 6px; flex: 0 0 auto; color: #9fb19f; font-size: 10px; white-space: nowrap; }
  .proof-choice select { height: 25px; max-width: 108px; padding: 0 5px; border: 1px solid #435447; border-radius: 3px; background: #243128; color: #d9e5d3; font-size: 10px; }
  .comparison-actions { display: flex; flex: 0 0 auto; border: 1px solid #435447; border-radius: 4px; overflow: hidden; }
  .comparison-actions button { height: 25px; padding: 0 8px; border: 0; border-right: 1px solid #435447; background: #243128; color: #b8cbb5; font-size: 10px; white-space: nowrap; }
  .comparison-actions button:last-child { border-right: 0; }
  .comparison-actions button[aria-pressed="true"] { background: #405443; color: #f1f7ec; }
  .comparison-actions button:hover:enabled { background: #354838; }
  .icon-button { height: 27px; padding: 0 8px; display: inline-flex; align-items: center; justify-content: center; gap: 6px; border: 1px solid #435447; border-radius: 4px; background: #243128; color: #c7d9c1; font-size: 10px; }
  .icon-button:hover:enabled, .icon-button[aria-pressed="true"] { background: #405443; color: #f1f7ec; }
  .crop-icon { position: relative; width: 17px; height: 17px; flex: 0 0 17px; }
  .crop-icon::before, .crop-icon::after { content: ""; position: absolute; width: 11px; height: 11px; }
  .crop-icon::before { left: 1px; top: 1px; border-left: 2px solid currentColor; border-bottom: 2px solid currentColor; }
  .crop-icon::after { right: 1px; bottom: 1px; border-top: 2px solid currentColor; border-right: 2px solid currentColor; }
  .stage { position: relative; flex: 1; min-height: 0; overflow: hidden; background: #0f1310; }
  .preview { position: absolute; inset: 16px; }
  .preview-error { min-width: 0; flex: 1; display: flex; align-items: center; justify-content: space-between; gap: 12px; color: #ffe5d9; font-size: 10px; }
  .preview-error > span { min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .preview-recovery { display: flex; flex: 0 0 auto; gap: 8px; }
  .preview-recovery button { padding: 5px 8px; border: 1px solid #b99280; border-radius: 3px; background: #4b3028; color: #ffe5d9; font-size: 11px; }
  .empty { position: absolute; inset: 0; display: flex; flex-direction: column; align-items: center; justify-content: center; text-align: center; gap: 11px; pointer-events: none; }
  .empty button { pointer-events: auto; margin-top: 10px; }
  .empty-mark { color: #9eaf9b; font-size: 37px; }
  .empty-title { margin: 0; font-size: 20px; font-weight: 500; letter-spacing: .01em; }
  .empty p { margin: 0; color: #829386; }
  .canvas-footer { height: 31px; flex: 0 0 31px; display: flex; align-items: center; justify-content: flex-end; padding: 0 12px; border-top: 1px solid #252c27; color: #839787; font-size: 10px; background: #1a211c; }
  .canvas-footer span { margin-right: auto; }
  .develop-rail { position: relative; min-width: 0; min-height: 0; display: flex; flex-direction: column; overflow: hidden; border-left: 1px solid #303832; background: #1d2420; }
  .develop-header { height: 40px; flex: 0 0 40px; display: flex; align-items: center; justify-content: space-between; padding: 0 12px; border-bottom: 1px solid #313b33; }
  .develop-header h2 { margin: 0; font-size: 13px; font-weight: 650; }
  .histogram { height: 143px; flex: 0 0 143px; padding: 10px 12px 8px; border-bottom: 1px solid #313b33; background: #1b221e; }
  .histogram-heading { height: 18px; display: flex; align-items: flex-start; justify-content: space-between; color: #9eb19f; font-size: 9px; font-weight: 600; letter-spacing: .11em; }
  .histogram-mode { color: #708876; font-size: 8px; font-weight: 500; letter-spacing: .06em; }
  .histogram-grid { position: relative; height: 88px; display: grid; place-items: center; overflow: hidden; border: 1px solid #39453e; border-radius: 3px; background: #101512; color: #9eaf9e; font-size: 10px; }
  .histogram-grid span { position: relative; padding: 4px 8px; border-radius: 3px; background: #1b221ee8; }
  .histogram-preview { position: absolute; inset: 0; }
  .histogram-scale { display: flex; justify-content: space-between; padding-top: 7px; color: #788c7c; font-size: 8px; letter-spacing: .06em; }
  .develop-tabs { height: 36px; flex: 0 0 36px; display: flex; align-items: stretch; border-bottom: 1px solid #313b33; color: #788b7c; font-size: 10px; }
  .develop-tabs button { flex: 1; padding: 0 8px; border: 0; border-bottom: 2px solid transparent; background: transparent; color: #8fa391; font-size: 11px; }
  .develop-tabs button:hover { color: #dce7d4; background: #263129; }
  .develop-tabs .selected { border-bottom-color: #bfd3ae; color: #dce7d4; }
  .help-card { position: absolute; z-index: 2; pointer-events: none; top: 222px; right: 9px; left: 9px; padding: 11px; border: 1px solid #79947a; border-radius: 5px; background: #26362b; box-shadow: 0 8px 22px #0b130da8; color: #e1eadd; font-size: 11px; line-height: 1.45; }
  .develop-content { flex: 1 1 0; min-height: 0; overflow-y: auto; overscroll-behavior: contain; padding: 16px 13px; }
  .group-title-row { display: flex; align-items: center; justify-content: space-between; gap: 8px; }
  .reset-button { border: 0; background: transparent; color: #aec6a7; font-size: 10px; padding: 3px 0; }
  .reset-button:hover:enabled { color: #d6e8ca; text-decoration: underline; }
  .hidden-control, .develop-content.inactive { display: none; }
  .adjustment-section { margin: 0 0 18px; padding: 0 2px; }
  .adjustment-section + .adjustment-section { border-top: 1px solid #354139; padding-top: 18px; }
  .adjustment-section .control-section { margin-bottom: 12px; padding: 0; border: 0; color: #b8ccb4; font-size: 10px; letter-spacing: .08em; }
  .adjustment-section .control-cue { color: #9daf9e; }
  .adjustment-section .color-methods { margin-top: 14px; }
  .creative-color .disclosure-button { margin: 0; padding: 5px 0; }
  .control-section { margin: 0 0 17px; padding-top: 3px; color: #91a694; font-size: 10px; font-weight: 600; letter-spacing: .06em; text-transform: uppercase; }
  .control-section:not(:first-of-type) { border-top: 1px solid #344038; padding-top: 17px; }
  .group-description { color: #839587; font-size: 11px; line-height: 1.45; margin: 7px 0 22px; }
  .control-cue { color: #839587; font-size: 11px; line-height: 1.45; margin: -10px 0 14px; }
  .availability { color: #a1b4a4; background: #263129; border: 1px solid #3a4a3c; border-radius: 5px; padding: 12px; font-size: 11px; line-height: 1.5; }
  .develop-divider { height: 1px; background: #344038; margin: 24px 0 20px; }
  .source-safety { color: #849a87; font-size: 11px; }
  .filmstrip { height: 92px; flex: 0 0 92px; display: flex; flex-direction: column; border-top: 1px solid #323c34; background: #19201b; }
  .filmstrip-content { flex: 1; display: flex; align-items: center; gap: 9px; padding: 7px 11px; }
