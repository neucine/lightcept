<template>
  <div class="zoom-controls" role="group" aria-label="Photograph zoom">
    <span class="preview-label">{{ props.sourceDetailReady ? 'Source detail' : 'Preview' }}</span>
    <div class="zoom-group" role="group" aria-label="Zoom level">
      <input aria-label="Zoom level" type="range" min="0" max="100" step="1"
        :value="sliderValue()" @input="preview" @change="change" />
      <button :aria-pressed="props.percent === 100 ? 'true' : 'false'" @click="selectHundred">100%</button>
    </div>
    <button class="fit-state" :aria-pressed="props.percent === 0 ? 'true' : 'false'" title="Return to fitted view" @click="selectFit">{{ props.percent === 0 ? 'Fit' : `${props.percent}%` }}</button>
  </div>
</template>

<script lang="ts">
  export interface Props { percent: number; sourceDetailReady: boolean; }
  export let props: Props;
  function sliderValue() {
    return props.percent === 0 ? 0 : Math.round(5 + Math.log(props.percent / 100) / Math.log(4) * 95);
  }
  function sliderPercent(value: number) {
    if (value < 3) return 0;
    return Math.max(100, Math.min(400, Math.round(100 * Math.pow(4, Math.max(0, value - 5) / 95) / 5) * 5));
  }
  function preview(event: Event) { emit('preview', sliderPercent(Number((event.target as HTMLInputElement).value))); }
  function change(event: Event) { emit('select', sliderPercent(Number((event.target as HTMLInputElement).value))); }
  function selectFit() { emit('select', 0); }
  function selectHundred() { emit('select', 100); }
</script>

<style>
  .zoom-controls { display: flex; align-items: center; gap: 7px; }
  .zoom-group { display: flex; align-items: center; gap: 5px; }
  .preview-label { margin-right: 5px; color: #9fb19f; }
  button { display: inline-flex; align-items: center; justify-content: center; box-sizing: border-box; min-width: 28px; height: 23px; padding: 0 7px; border: 1px solid #39473c; border-radius: 3px; background: #222c25; color: #c8d7c4; font-family: inherit; font-size: 10px; line-height: 1; cursor: pointer; }
  button[aria-pressed="true"] { border-color: #a2bc99; background: #354738; }
  button:disabled { opacity: .45; cursor: default; }
  input[type="range"] { width: 138px; height: 22px; margin: 0 7px; appearance: none; -webkit-appearance: none; background: transparent; cursor: pointer; }
  input[type="range"]::-webkit-slider-runnable-track { height: 5px; border-radius: 5px; background: linear-gradient(90deg, #91ad8a, #d0debf); box-shadow: inset 0 0 0 1px #526750; }
  input[type="range"]::-webkit-slider-thumb { appearance: none; -webkit-appearance: none; width: 17px; height: 17px; margin-top: -6px; border: 2px solid #e4efdb; border-radius: 50%; background: #405b43; box-shadow: 0 1px 4px #0009; }
  input[type="range"]:focus-visible { outline: 2px solid #d5e4c8; outline-offset: 3px; border-radius: 4px; }
  .fit-state { min-width: 46px; margin-left: 2px; padding: 0 3px; border-color: transparent; background: transparent; color: #bacdb6; font-variant-numeric: tabular-nums; }
  .fit-state:hover { color: #e2ecd9; }
  .fit-state[aria-pressed="true"] { border-color: transparent; background: transparent; color: #e2ecd9; }
</style>
